# ── AI Providers ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DISABLE_GEMINI=false

# ── Gmail OAuth ──
GMAIL_CREDENTIALS_PATH=client_secret.json
GMAIL_TOKEN_PATH=token.json
MAX_BODY_CHARS=6000
OUTPUT_DIR=outputs

# ── URLs (dev) ──
WEB_FRONTEND_URL=http://localhost:5173
WEB_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── URLs (production) - uncomment and update for deployment on Render + Vercel ──
# WEB_FRONTEND_URL=https://aegis-mail.vercel.app
# WEB_REDIRECT_URI=https://aegis-mail-api.onrender.com/auth/google/callback
# SESSION_COOKIE_SECURE=true
# ALLOWED_HOSTS=aegis-mail-api.onrender.com,localhost

# ── Session ──
SESSION_SECRET=change-me-to-a-long-random-secret
TOKEN_DIR=tokens
TOKEN_ENCRYPTION_KEY=

# ── Firebase Admin SDK ──
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
